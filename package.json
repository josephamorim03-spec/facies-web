{
  "name": "krosmed-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev --hostname 0.0.0.0 --port 3000",
    "dev:e2e": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "dev:web": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:api": "npm --prefix .. run dev:api",
    "dev:all": "npm --prefix .. run dev:all",
    "build": "next build",
    "analyze": "next experimental-analyze --output",
    "audit:security": "npm audit --audit-level=moderate",
    "start": "next start",
    "start:e2e": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "api:types": "openapi-typescript ../openapi.yaml -o src/lib/api/generated/schema.d.ts",
    "generate:kros-intro": "node scripts/generate-kros-intro-sprite.mjs",
    "lint": "node scripts/check-mojibake.mjs && node scripts/check-portuguese-ui-copy.mjs && node scripts/check-student-ui-tokens.mjs && node scripts/check-student-vocabulary.mjs && eslint .",
    "lint:ui": "node scripts/check-portuguese-ui-copy.mjs && node scripts/check-student-ui-tokens.mjs && node scripts/check-student-vocabulary.mjs",
    "test:unit": "node --test --experimental-strip-types tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "precapture:design": "npm run build",
    "capture:design": "node scripts/capture-design-redesign.mjs",
    "test:e2e:smoke": "node scripts/run-smoke-e2e.mjs",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "radix-ui": "^1.6.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "22.13.5",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.2.12",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.5.19",
    "sharp": "^0.35.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
